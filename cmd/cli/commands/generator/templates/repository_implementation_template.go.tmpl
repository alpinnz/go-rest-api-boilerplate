}

func (r *PLACEHOLDER_entityRepository) Count(ctx context.Context) (int64, error) {
	query := `SELECT COUNT(*) FROM PLACEHOLDER_entities WHERE deleted_at IS NULL`

	var count int64
	err := r.db.QueryRowContext(ctx, query).Scan(&count)
	if err != nil {
		return 0, err
	}

	return count, nil
}

func (r *PLACEHOLDER_entityRepository) Restore(ctx context.Context, id uuid.UUID) error {
	query := `
		UPDATE PLACEHOLDER_entities
		SET deleted_at = NULL, updated_at = $1
		WHERE id = $2 AND deleted_at IS NOT NULL
	`

	result, err := r.db.ExecContext(ctx, query, time.Now(), id)
	if err != nil {
		return err
	}

	rows, err := result.RowsAffected()
	if err != nil {
